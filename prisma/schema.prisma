generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         Profile?
  privacySettings PrivacySettings?

  feedbackGiven    Feedback[] @relation("FeedbackGiven")
  feedbackReceived Feedback[] @relation("FeedbackReceived")

  friendRequestsSent     FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")

  firstUser  Friendship[] @relation("FirstUser")
  secondUser Friendship[] @relation("SecondUser")

  notification Notification[] @relation("Recipient")

  reputationEvents  ReputationEvent[]
  feedbackResponses FeedbackResponse[]

  safetyReportsCreated SafetyReport[] @relation("SafetyReportsCreated")

  role                UserRole             @default(USER)
  safetyReportActions SafetyReportAction[]
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  firstName String?
  lastName  String?
  bio       String?

  user User @relation(fields: [userId], references: [id])
}

model PrivacySettings {
  userId                 String  @id
  allowAnonymousFeedback Boolean @default(true)
  allowFeedbackFrom      String  @default("everyone")
  discoverable           Boolean @default(true)
  showFriendsList        Boolean @default(true)
  showReputation         Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

enum FeedbackType {
  APPRECIATION
  CONSTRUCTIVE
  ENCOURAGEMENT
  APOLOGY
  GRATITUDE
}

enum ReputationDimension {
  KINDNESS
  RESPECT
  RELIABILITY
  ACCOUNTABILITY
}

enum FeedbackResponseType {
  UNDERSTAND
  DISAGREE
  DISCUSS
  SORRY
  CHANGED
  INACCURATE
  REVIEW_REQUEST
}

enum FeedbackVisibility {
  PRIVATE
  PUBLIC
}

enum SafetyReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum UserRole {
  USER
  MODERATOR
}

model Feedback {
  id         String             @id @default(uuid())
  fromUserId String
  toUserId   String
  content    String
  visibility FeedbackVisibility @default(PRIVATE)
  createdAt  DateTime           @default(now())

  fromUser User @relation("FeedbackGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("FeedbackReceived", fields: [toUserId], references: [id])

  type      FeedbackType?
  dimension ReputationDimension?

  reputationEvent ReputationEvent?

  responses FeedbackResponse[]

  safetyReports SafetyReport[]
}

model ReputationEvent {
  id                String              @id @default(uuid())
  feedbackId        String              @unique
  userId            String
  dimension         ReputationDimension
  scoreValue        Float
  rawWeight         Float
  senderTrustAtTime Float               @default(0.5)
  createdAt         DateTime            @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender    User @relation("FriendRequestsSent", fields: [senderId], references: [id])
  recipient User @relation("FriendRequestsReceived", fields: [recipientId], references: [id])

  @@unique([senderId, recipientId])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FirstUser", fields: [userAId], references: [id])
  userB User @relation("SecondUser", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("Recipient", fields: [userId], references: [id])
}

model FeedbackResponse {
  id           String               @id @default(uuid())
  feedbackId   String
  responderId  String
  responseType FeedbackResponseType
  body         String?
  createdAt    DateTime             @default(now())

  feedback  Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  responder User     @relation(fields: [responderId], references: [id])
}

model SafetyReport {
  id         String             @id @default(uuid())
  feedbackId String
  reporterId String
  reason     String
  status     SafetyReportStatus @default(PENDING)
  createdAt  DateTime           @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)

  reporter User @relation("SafetyReportsCreated", fields: [reporterId], references: [id], onDelete: Restrict)

  actions SafetyReportAction[]

  @@unique([feedbackId, reporterId])
  @@index([status, createdAt])
}

model SafetyReportAction {
  id             String             @id @default(uuid())
  reportId       String
  moderatorId    String
  previousStatus SafetyReportStatus
  newStatus      SafetyReportStatus
  explanation    String?
  createdAt      DateTime           @default(now())

  report    SafetyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  moderator User         @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([moderatorId, createdAt])
}
